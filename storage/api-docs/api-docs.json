        "/login": {
            "post": {
                "tags": [
                    "Auth"
                ],
                "summary": "Login user (MasterPegawai)",
                "operationId": "a3674f0652b564b652bd25c2326691d7",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "required": [
                                    "email",
                                    "password"
                                ],
                                "properties": {
                                    "email": {
                                        "type": "string",
                                        "example": "admin@gmail.com"
                                    },
                                    "password": {
                                        "type": "string",
                                        "example": "password123"
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Login sukses, return token"
                    },
                    "401": {
                        "description": "Unauthorized"
                    }
                }
            }
        },
